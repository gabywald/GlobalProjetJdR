% ======================
% 4. SCÉNARIOS
% ======================
\newpage
\section{Scénarios}

\subsection{Scénarios courts (1-2 sessions)}

\subsubsection{"La Chasse à l'Appartement"}
\textbf{Synopsis} : Les joueurs doivent trouver un logement décent dans une ville où les loyers sont exorbitants.

\textbf{Missions} :
\begin{enumerate}
    \item \textbf{Recherche d'annonces} : Trouver 3 annonces intéressantes (jet de PER + Gestion).
    \item \textbf{Visite des logements} : Convaincre les propriétaires de vous laisser visiter (jet de CHA + Persuasion).
    \item \textbf{Réunir la caution} : Trouver l'argent nécessaire (jet de INT + Technologie pour un prêt, ou ADR + Artisanat pour un petit boulot).
    \item \textbf{Négociation finale} : Convaincre le propriétaire de vous choisir (3 jets de CHA + Persuasion ou INT + Négociation contre le propriétaire, qui a CHA 16 et PER 14).
\end{enumerate}

\textbf{Récompenses} :
\begin{itemize}
    \item Clés de l'appartement (objet rare).
    \item +300 XP.
    \item Accès au scénario \textbf{"Colocation : Mode Chaos"} (optionnel).
\end{itemize}

% ----------------------
\subsubsection{"L'Examen de la Dernière Chance"}
\textbf{Synopsis} : Un joueur doit réussir un examen crucial pour valider son année.

\textbf{Étapes} :
\begin{enumerate}
    \item \textbf{Révision} : Étudier efficacement (jet de INT + Mémoire).
    \item \textbf{Gestion du stress} : Éviter de paniquer (jet de PER + Calme).
    \item \textbf{Épreuve écrite} : Répondre aux questions (jet de INT + Logique).
    \item \textbf{Oral} : Convaincre le jury (jet de CHA + Éloquence contre le professeur, qui a INT 16 et PER 14).
\end{enumerate}

\textbf{Récompenses} :
\begin{itemize}
    \item Diplôme (objet rare, +2 en Intelligence pour les missions liées à l'emploi).
    \item +250 XP.
\end{itemize}

% ----------------------
\subsubsection{"Soirée Catastrophe"}
\textbf{Synopsis} : Les joueurs organisent une soirée chez eux, mais tout semble vouloir mal tourner.

\textbf{Objectifs} :
\begin{itemize}
    \item Acheter de la nourriture et des boissons (jet de ADR + Cuisine pour éviter les intoxications).
    \item Inviter des amis (jet de CHA + Réseautage).
    \item Éviter que les voisins n'appellent la police (jet de ADR + Discrétion toutes les 30 minutes).
\end{itemize}

\textbf{Événement aléatoire} : Un invité trop ivre déclenche un conflit (jet de FOR + Résistance à l'alcool vs CHA + Persuasion pour le calmer).

\textbf{Récompenses} :
\begin{itemize}
    \item +150 XP.
    \item Objet aléatoire (ex : "Bouteille de vin de luxe", "Numéro de téléphone d'un inconnu").
\end{itemize}

% ----------------------
\subsection{Campagnes longues}

\subsubsection{"De Zéro à Héros"}
\textbf{Synopsis} : Les joueurs commencent sans le sou et doivent s'en sortir par eux-mêmes.

\textbf{Étapes possibles} :
\begin{itemize}
    \item Trouver un petit boulot (missions : livraison, baby-sitting, etc.).
    \item Se former (missions : cours du soir, stages).
    \item Créer une entreprise ou une association.
    \item \textbf{Défis finaux} : Affronter un "patron" corrompu ou un rival malveillant (ex : un concurrent en affaires).
\end{itemize}

\textbf{Thèmes abordés} :
\begin{itemize}
    \item Les inégalités sociales.
    \item L'importance du réseautage.
    \item La gestion des ressources (temps, argent, énergie).
\end{itemize}

% ----------------------
\subsubsection{"Le Bug de la Réalité"}
\textbf{Synopsis} : Une anomalie fait que la réalité commence à fonctionner comme un jeu vidéo. Les PNJ répètent les mêmes phrases, des objets disparaissent, etc.

\textbf{Mécaniques spéciales} :
\begin{itemize}
    \item \textbf{Anomalies aléatoires} : Chaque session, le MJ lance 1d10 pour appliquer un effet (ex : "Tous les jets sont désavantagés", "Les objets pèsent 2x plus").
    \item \textbf{Missions de réparation} : Trouver la source du bug (ex : "Localiser le serveur central" avec un jet de INT + Technologie).
\end{itemize}

% ----------------------
\subsubsection{"La Colocation de l'Enfer"}
\textbf{Synopsis} : Les joueurs emménagent ensemble et doivent gérer les défis de la vie en colocation.

\textbf{Quêtes récurrentes} :
\begin{itemize}
    \item Faire le ménage (jet de ADR + Artisanat).
    \item Payer les factures à temps (jet de PER + Gestion).
    \item Éviter les conflits entre colocataires (jet de CHA + Diplomatie).
\end{itemize}

\textbf{Événements} :
\begin{itemize}
    \item Un colocataire invite 20 personnes sans prévenir.
    \item Le frigo tombe en panne.
    \item Un voisin se plaint du bruit.
\end{itemize}

\textbf{Récompenses} :
\begin{itemize}
    \item Amélioration de l'appartement (ex : "Canapé confortable" = +1 en Santé quand on s'y repose).
    \item \textbf{Fin alternative} : Si les joueurs échouent trop, la colocation explose et ils doivent déménager.
\end{itemize}

% ----------------------
\subsection{Scénarios thématiques}

\begin{center}
    \begin{tabular}{|>{\bfseries}l|p{6cm}|p{5cm}|}
        \hline
        \textbf{Thème} & \textbf{Idée de scénario} & \textbf{Mécaniques spéciales}	\\
        \hline
        Amour & Trouver l'âme sœur via une appli de rencontre. & Jets de CHA + Séduction vs PER + Détection de mensonges du PNJ.	\\
        \hline
        Survie & Survivre une semaine avec 50 euros. & Gestion stricte des ressources (nourriture, transport).	\\
        \hline
        Enquête & Résoudre la disparition d'un voisin. & Jets de PER + Observation pour trouver des indices.	\\
        \hline
        Aventure & Road-trip en Europe avec un budget serré. & Mini-jeux pour les transports (ex : "Trouver un covoiturage").	\\
        \hline
        Horreur & Un joueur est hanté par une "anomalie". & Jets de PER + Volonté pour résister à la folie.	\\
        \hline
    \end{tabular}
\end{center}

% ======================
% 5. CONSEILS POUR LE MJ
% ======================
\newpage
\section{Conseils pour le Meneur de Jeu (MJ)}

\begin{itemize}
    \item \textbf{Adaptez les scénarios} à la vie réelle des joueurs (ex : si un joueur est étudiant, proposez des missions liées aux examens).
    \item \textbf{Utilisez des PNJ stéréotypés} : le voisin râleur, le patron tyrannique, l'ami toujours en retard, le commerçant radin.
    \item \textbf{Encouragez la créativité} : Les joueurs peuvent proposer des actions originales (ex : "J'organise un flashmob pour distraire le vigile").
    \item \textbf{Équilibrez les défis} : Assurez-vous que les missions ne sont ni trop faciles ni trop difficiles.
    \item \textbf{Ajoutez des clins d'œil} : Références à la culture française (ex : un PNJ nommé "Gérard" qui tient un café, une mission pour "trouver une baguette parfaite").
    \item \textbf{Improvisez} : N'hésitez pas à créer des événements imprévus en fonction des actions des joueurs.
\end{itemize}

% ======================
% 6. EXTENSIONS POSSIBLES
% ======================
\section{Extensions possibles}

\begin{itemize}
    \item \textbf{Métiers} : À haut niveau, les joueurs peuvent choisir un métier (ex : "Hacker", "Artiste de rue", "Chef cuisinier") avec des compétences uniques.
    \item \textbf{Réputation} : Selon leurs actions, les joueurs gagnent ou perdent de la réputation dans différents milieux (ex : "Ami des animaux", "Ennemi des banquiers").
    \item \textbf{Mode difficile} : Pas de sauvegarde, mort définitive, ressources très limitées.
    \item \textbf{Éléments fantastiques} : Intégrez des pouvoirs ou des créatures pour un mélange humoristique (ex : un joueur découvre qu'il peut lancer des sorts… mais c'est juste un effet secondaire d'un médicament).
\end{itemize}

% ======================
% 7. EXEMPLE DE SESSION
% ======================
\section{Exemple de session type}

\textbf{Titre} : "Premier jour au travail"
\textbf{Joueurs} : 3 (Pierre, Marie, Thomas).
\textbf{Synopsis} : Les joueurs commencent un nouveau travail dans une startup. Leur mission : survivre à la journée sans se faire virer.

\textbf{Déroulé} :
\begin{enumerate}
    \item \textbf{Arriver à l'heure} : Éviter les retards (jet de PER + Ponctualité).
    \item \textbf{Faire bonne impression} : Présenter un projet au boss (jet de CHA + Persuasion).
    \item \textbf{Éviter un collègue toxique} : Détecter ses manipulations (jet de PER + Détection de mensonges).
    \item \textbf{Événement aléatoire} : La machine à café tombe en panne → mini-jeu pour la réparer (jet de ADR + Bricolage).
    \item \textbf{Défis final} : Convaincre un client mécontent de signer un contrat (PNJ avec CHA 15 et INT 12).
\end{enumerate}

\textbf{Récompenses} :
\begin{itemize}
    \item Salaire de la journée (50 euros).
    \item +200 XP.
    \item Objet : "Carte de visite" (+1 en Charisme pour les interactions professionnelles).
\end{itemize}

% ======================
% 8. MATÉRIEL NÉCESSAIRE
% ======================
\section{Matériel nécessaire}

\begin{itemize}
    \item Fiches de personnage (voir exemple ci-dessus).
    \item Dés : 1d4, 1d6, 1d20 (et éventuellement d'autres pour des variantes).
    \item Feuilles de notes : Pour noter les missions et les récompenses.
    \item Accessoires : Post-it pour les objets, jetons ou pièces pour l'argent, etc.
\end{itemize}

